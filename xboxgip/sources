TARGETNAME=xboxgip
TARGETTYPE=DRIVER

KMDF_VERSION_MAJOR=1

MSC_WARNING_LEVEL=/W4

# Set by build.cmd so logs show which release is running.
!IFDEF XGIP_REVISION
C_DEFINES=$(C_DEFINES) -DXGIP_REVISION=$(XGIP_REVISION)
!ENDIF
!IFDEF XGIP_BETA
C_DEFINES=$(C_DEFINES) -DXGIP_BETA=$(XGIP_BETA)
!ENDIF

# Set by build.cmd for the Xbox 360 layout variant (x86-x360, amd64-x360).
!IFDEF XGIP_X360_MODE
C_DEFINES=$(C_DEFINES) -DXGIP_X360_MODE=$(XGIP_X360_MODE)
!ENDIF

SOURCES= \
    driver.c \
    usb.c \
    gip.c \
    hid.c \
    xinput.c
